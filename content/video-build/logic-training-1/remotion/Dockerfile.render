# Remotion レンダリング用（WSL に Chrome の共有ライブラリが無いため Docker 経由で実行する）
# ビルド:  docker build -f Dockerfile.render -t remotion-render .
# 実行例:  docker run --rm -v "$PWD:/work" -w /work -e HOME=/tmp --user $(id -u):$(id -g) \
#            remotion-render npx remotion render src/index.ts RankingProto out/ranking-proto.mp4
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libpango-1.0-0 libcairo2 libasound2 libglib2.0-0 \
    libx11-6 libxcb1 libxext6 libexpat1 \
    && rm -rf /var/lib/apt/lists/*
